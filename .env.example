# Student/admin web apps
NEXT_PUBLIC_API_BASE_URL="https://<api-project>.vercel.app"

# API / Prisma
# Runtime connection for serverless deployments. Use Supabase Supavisor transaction pooler.
DATABASE_URL="postgresql://prisma.<project-ref>:<password>@<region>.pooler.supabase.com:6543/postgres?pgbouncer=true&connection_limit=1"

# Migration connection. Use Supabase direct connection or Supavisor session pooler.
DIRECT_URL="postgresql://prisma.<project-ref>:<password>@<region>.pooler.supabase.com:5432/postgres"

# Comma-separated Vercel origins allowed to call the API.
CORS_ORIGIN="https://<web-project>.vercel.app,https://<admin-project>.vercel.app"

# API Auth configuration
AUTH_TOKEN_SECRET="replace-with-a-long-random-secret"
AUTH_SESSION_DAYS=14

# Server-only key. Never expose this with NEXT_PUBLIC_.
ELEVENLABS_API_KEY=""
ELEVENLABS_VOICE_ID="g14YnDYCsy3k7XLlcKlO"

# Google Gemini (exam-paper AI verification). Server-only; never NEXT_PUBLIC_.
GEMINI_API_KEY=""
GEMINI_MODEL="gemini-2.5-flash"

# Bunny Stream. Server-only; do not expose these with NEXT_PUBLIC_.
BUNNY_STREAM_LIBRARY_ID=""
BUNNY_STREAM_API_KEY=""
BUNNY_STREAM_CDN_HOSTNAME="<pull-zone>.b-cdn.net"
BUNNY_STREAM_TOKEN_AUTH_KEY=""
BUNNY_STREAM_SIGNED_URL_TTL_SECONDS=1800
VIDEO_ACTIVE_STATUS_SYNC_TTL_SECONDS=30
VIDEO_TERMINAL_STATUS_SYNC_TTL_SECONDS=21600
BUNNY_STORAGE_ZONE_NAME=""
BUNNY_STORAGE_ACCESS_KEY=""
BUNNY_STORAGE_ENDPOINT="https://storage.bunnycdn.com"
