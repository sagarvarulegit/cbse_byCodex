{
  "name": "cbse-learning-portal",
  "private": true,
  "version": "0.1.0",
  "packageManager": "npm@10.2.0",
  "workspaces": [
    "apps/web",
    "apps/admin",
    "apps/api"
  ],
  "scripts": {
    "dev:web": "npm run dev -w apps/web",
    "dev:admin": "npm run dev -w apps/admin",
    "dev:api": "npm run dev -w apps/api",
    "build": "npm run build -w apps/web && npm run build -w apps/admin && npm run build -w apps/api",
    "lint": "npm run lint -w apps/web && npm run lint -w apps/admin && npm run lint -w apps/api",
    "skillopt:status": "python -m skillopt_sleep status --project . --json",
    "skillopt:dry-run": "python -m skillopt_sleep dry-run --project . --source codex --backend mock --max-sessions 5 --max-tasks 3 --json",
    "skillopt:harvest": "python -m skillopt_sleep harvest --project . --source codex --max-sessions 5 --max-tasks 3 --output skillopt-reviewed-tasks.json",
    "skillopt:run": "python -m skillopt_sleep run --project . --source codex --backend codex --max-sessions 5 --max-tasks 3 --target-skill-path .agents/skills/cbse-project/SKILL.md --progress"
  },
  "overrides": {
    "postcss": "^8.5.10"
  }
}
