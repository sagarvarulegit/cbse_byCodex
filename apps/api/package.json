{
  "name": "@cbse/api",
  "private": true,
  "version": "0.1.0",
  "scripts": {
    "dev": "tsx watch src/main.ts",
    "build": "prisma generate && tsc -p tsconfig.json",
    "bunny:upload-video": "tsx src/scripts/upload-bunny-video.ts",
    "elevenlabs:voiceover": "tsx src/scripts/generate-elevenlabs-voiceover.ts",
    "seed:bank": "tsx src/scripts/seed-question-bank.ts",
    "seed:bank:validate": "tsx src/scripts/validate-bank-seed.ts",
    "seed:bank:analyze": "tsx src/scripts/analyze-bank-coverage.ts",
    "verify:bank": "tsx src/scripts/verify-bank.ts",
    "verify:papers": "tsx src/scripts/verify-papers.ts",
    "start": "node dist/main.js",
    "lint": "prisma generate && tsc -p tsconfig.json --noEmit",
    "prisma:generate": "prisma generate",
    "prisma:migrate": "prisma migrate dev",
    "prisma:migrate:deploy": "prisma migrate deploy",
    "test": "node --import tsx --test src/**/*.test.ts"
  },
  "dependencies": {
    "@prisma/client": "^6.0.0",
    "cors": "^2.8.5",
    "dotenv": "^16.4.0",
    "express": "^4.19.0"
  },
  "devDependencies": {
    "@types/cors": "^2.8.17",
    "@types/express": "^4.17.21",
    "@types/node": "^22.0.0",
    "prisma": "^6.0.0",
    "tsx": "^4.19.0",
    "typescript": "^5.0.0"
  }
}
