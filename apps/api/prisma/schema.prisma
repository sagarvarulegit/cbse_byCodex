generator client {
  provider        = "prisma-client-js"
  previewFeatures = ["postgresqlExtensions"]
}

datasource db {
  provider   = "postgresql"
  url        = env("DATABASE_URL")
  directUrl  = env("DIRECT_URL")
  extensions = [vector]
}

enum UserRole {
  student
  admin
  teacher_reviewer
  support
}

enum AccessLevel {
  free
  premium
}

enum PublishStatus {
  draft
  review
  published
  archived
}

enum MasteryLevel {
  learner
  skilled
  exam_ready
  topper_track
}

enum RevisionMissionStatus {
  active
  completed
  expired
}

enum MistakeKind {
  quiz_question
  weak_concept
  hint_used
  written_marking_point
}

model User {
  id           String   @id @default(cuid())
  email        String?  @unique
  phone        String?  @unique
  passwordHash String?
  role         UserRole @default(student)
  status       String   @default("active")
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  profile          UserProfile?
  guardianConsent  GuardianConsent?
  subscriptions    Subscription[]
  progressEvents   ProgressEvent[]
  quizAttempts     QuizAttempt[]
  writtenPracticeAttempts WrittenPracticeAttempt[]
  mistakeReviewItems MistakeReviewItem[]
  examPaperAttempts ExamPaperAttempt[]
  tutorConversations TutorConversation[]
  examReadyChecklists ExamReadyChecklist[]
  chapterMasteries ChapterMastery[]
  revisionMissions RevisionMission[]
  studyStreak      StudyStreak?
  userBadges       UserBadge[]
  paymentOrders    PaymentOrder[]
  entitlements     UserEntitlement[]
  refundRequests   RefundRequest[]
}

model GuardianConsent {
  id                 String   @id @default(cuid())
  userId             String   @unique
  guardianFullName   String
  guardianEmail      String
  relationship       String
  policyVersion      String
  verificationStatus String   @default("self_attested")
  consentedAt        DateTime @default(now())
  revokedAt          DateTime?
  createdAt          DateTime @default(now())
  updatedAt          DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([policyVersion, consentedAt])
}

model UserProfile {
  id                String   @id @default(cuid())
  userId            String   @unique
  fullName          String
  classLevel        Int      @default(10)
  schoolName        String?
  targetExamYear    Int?
  preferredLanguage String   @default("en")
  themePreference   String   @default("system")
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt

  user User @relation(fields: [userId], references: [id])
}

model Subject {
  id          String  @id @default(cuid())
  classLevel  Int
  name        String
  slug        String  @unique
  description String?
  sortOrder   Int     @default(0)
  isPublished Boolean @default(false)

  chapters Chapter[]

  @@index([classLevel, isPublished, sortOrder])
}

model Chapter {
  id                 String  @id @default(cuid())
  subjectId          String
  title              String
  slug               String  @unique
  ncertChapterNumber Int
  description        String?
  sortOrder          Int     @default(0)
  isPublished        Boolean @default(false)

  subject          Subject           @relation(fields: [subjectId], references: [id])
  topics           Topic[]
  quizAttempts     QuizAttempt[]
  writtenPracticeAttempts WrittenPracticeAttempt[]
  mistakeReviewItems MistakeReviewItem[]
  examReadyChecklists ExamReadyChecklist[]
  chapterMasteries ChapterMastery[]
  revisionMissions RevisionMission[]
  userBadges       UserBadge[]

  @@unique([subjectId, slug])
  @@index([subjectId, isPublished, sortOrder])
  @@index([slug, isPublished])
}

model Topic {
  id               String  @id @default(cuid())
  chapterId        String
  title            String
  slug             String
  description      String?
  sortOrder        Int     @default(0)
  estimatedMinutes Int?
  isPublished      Boolean @default(false)

  chapter          Chapter           @relation(fields: [chapterId], references: [id])
  lessons          Lesson[]
  quizAttempts     QuizAttempt[]
  revisionMissions RevisionMission[]

  @@unique([chapterId, slug])
  @@index([chapterId, isPublished, sortOrder])
}

model Lesson {
  id                String        @id @default(cuid())
  topicId           String
  title             String
  slug              String
  description       String?
  learningObjective String?
  accessLevel       AccessLevel   @default(premium)
  sortOrder         Int           @default(0)
  estimatedMinutes  Int?
  publishStatus     PublishStatus @default(draft)
  publishedAt       DateTime?
  createdAt         DateTime      @default(now())
  updatedAt         DateTime      @updatedAt

  topic  Topic   @relation(fields: [topicId], references: [id])
  videos Video[]
  notes  Note[]

  @@unique([topicId, slug])
  @@index([topicId, publishStatus, sortOrder])
  @@index([slug, publishStatus])
}

model Video {
  id                String    @id @default(cuid())
  lessonId          String
  provider          String    @default("bunny")
  providerLibraryId String?
  providerVideoId   String?
  playbackUrl       String?
  embedUrl          String?
  durationSeconds   Int?
  thumbnailUrl      String?
  drmRequired       Boolean   @default(false)
  offlineAllowed    Boolean   @default(false)
  processingStatus  String    @default("pending")
  statusSyncedAt    DateTime?
  createdAt         DateTime  @default(now())
  updatedAt         DateTime  @updatedAt

  lesson Lesson @relation(fields: [lessonId], references: [id])

  @@unique([provider, providerVideoId])
  @@index([lessonId, provider, updatedAt])
  @@index([processingStatus, statusSyncedAt])
}

model Note {
  id                     String   @id @default(cuid())
  lessonId               String
  title                  String
  bodyMarkdown           String
  summaryMarkdown        String?
  formulaMarkdown        String?
  commonMistakesMarkdown String?
  boardTipsMarkdown      String?
  createdAt              DateTime @default(now())
  updatedAt              DateTime @updatedAt

  lesson Lesson @relation(fields: [lessonId], references: [id])

  @@index([lessonId, createdAt])
}

model Quiz {
  id                  String      @id @default(cuid())
  title               String
  quizType            String
  accessLevel         AccessLevel @default(premium)
  timeLimitSeconds    Int?
  passingScorePercent Int?
  isPublished         Boolean     @default(false)
  createdAt           DateTime    @default(now())
  updatedAt           DateTime    @updatedAt

  attempts QuizAttempt[]
}

model QuizAttempt {
  id             String   @id @default(cuid())
  userId         String
  chapterId      String
  topicId        String?
  quizId         String?
  scorePercent   Int
  totalQuestions Int
  correctAnswers Int
  weakTopicSlugs String[] @default([])
  questionResults Json?
  attemptNumber  Int
  createdAt      DateTime @default(now())

  user    User    @relation(fields: [userId], references: [id])
  chapter Chapter @relation(fields: [chapterId], references: [id])
  topic   Topic?  @relation(fields: [topicId], references: [id])
  quiz    Quiz?   @relation(fields: [quizId], references: [id])

  @@unique([userId, chapterId, attemptNumber])
  @@index([userId, chapterId, createdAt])
  @@index([chapterId, scorePercent])
  @@index([quizId, createdAt])
}

model WrittenPracticeAttempt {
  id                    String   @id @default(cuid())
  userId                String
  chapterId             String
  clientAttemptId       String
  practiceItemId        String
  practiceKind          String   @default("written_practice")
  lessonSlug            String
  scoreHalfMarks        Int
  maxScoreHalfMarks     Int
  retentionEligible     Boolean  @default(true)
  earnedRubricPointIds  String[] @default([])
  missedRubricPointIds  String[] @default([])
  weakSkillSlugs        String[] @default([])
  usedHints             Boolean  @default(false)
  answerLength          Int
  attemptNumber         Int
  createdAt             DateTime @default(now())

  user    User    @relation(fields: [userId], references: [id])
  chapter Chapter @relation(fields: [chapterId], references: [id])

  @@unique([userId, practiceItemId, attemptNumber])
  @@unique([userId, clientAttemptId])
  @@index([userId, chapterId, createdAt])
  @@index([userId, practiceItemId, createdAt])
  @@index([chapterId, practiceItemId])
}

model MistakeReviewItem {
  id              String       @id @default(cuid())
  userId          String
  chapterId       String
  kind            MistakeKind
  itemKey         String
  sourceItemId    String?
  lessonSlug      String?
  conceptSlug     String?
  title           String
  detail          String?
  reviewHref      String
  metadata        Json?
  retryAt         DateTime
  occurrenceCount Int          @default(1)
  lastSeenAt      DateTime      @default(now())
  resolvedAt      DateTime?
  createdAt       DateTime      @default(now())
  updatedAt       DateTime      @updatedAt

  user    User    @relation(fields: [userId], references: [id], onDelete: Cascade)
  chapter Chapter @relation(fields: [chapterId], references: [id], onDelete: Cascade)

  @@unique([userId, itemKey])
  @@index([userId, resolvedAt, retryAt])
  @@index([chapterId, kind, resolvedAt])
}

model ExamPaperAttempt {
  id                String   @id @default(cuid())
  userId            String
  examPaperId       String
  clientAttemptId   String
  attemptNumber     Int
  totalMarks        Int
  earnedMarks       Int
  mcqCorrect        Int
  mcqTotal          Int
  writtenSelfMarked Boolean  @default(false)
  questionResults   Json?
  weakChapterSlugs  String[] @default([])
  weakQuestionTypes String[] @default([])
  createdAt         DateTime @default(now())

  user      User      @relation(fields: [userId], references: [id])
  examPaper ExamPaper @relation(fields: [examPaperId], references: [id])

  @@unique([userId, examPaperId, attemptNumber])
  @@unique([userId, clientAttemptId])
  @@index([userId, createdAt])
  @@index([examPaperId, createdAt])
}

model ExamReadyChecklist {
  id                       String   @id @default(cuid())
  userId                   String
  chapterId                String
  conceptsStudiedConfirmed Boolean  @default(false)
  ncertQuestionsAttempted  Boolean  @default(false)
  weakAreasRevised         Boolean  @default(false)
  createdAt                DateTime @default(now())
  updatedAt                DateTime @updatedAt

  user    User    @relation(fields: [userId], references: [id], onDelete: Cascade)
  chapter Chapter @relation(fields: [chapterId], references: [id], onDelete: Cascade)

  @@unique([userId, chapterId])
  @@index([userId, updatedAt])
  @@index([chapterId, updatedAt])
}

model ChapterMastery {
  id                     String       @id @default(cuid())
  userId                 String
  chapterId              String
  masteryScore           Int          @default(0)
  level                  MasteryLevel @default(learner)
  videoCompletionPercent Int          @default(0)
  bestQuizScorePercent   Int          @default(0)
  lastActivityAt         DateTime?
  createdAt              DateTime     @default(now())
  updatedAt              DateTime     @updatedAt

  user    User    @relation(fields: [userId], references: [id])
  chapter Chapter @relation(fields: [chapterId], references: [id])

  @@unique([userId, chapterId])
  @@index([userId, level, updatedAt])
  @@index([chapterId, masteryScore])
}

model RevisionMission {
  id               String                @id @default(cuid())
  userId           String
  chapterId        String
  topicId          String?
  status           RevisionMissionStatus @default(active)
  reason           String
  targetScore      Int                   @default(60)
  recommendedSteps Json
  createdAt        DateTime              @default(now())
  completedAt      DateTime?
  updatedAt        DateTime              @updatedAt

  user    User    @relation(fields: [userId], references: [id])
  chapter Chapter @relation(fields: [chapterId], references: [id])
  topic   Topic?  @relation(fields: [topicId], references: [id])

  @@index([userId, status, updatedAt])
  @@index([chapterId, status])
}

model StudyStreak {
  id                      String   @id @default(cuid())
  userId                  String   @unique
  currentStreakDays       Int      @default(0)
  longestStreakDays       Int      @default(0)
  lastActivityDate        DateTime?
  recoveryTokensAvailable Int      @default(0)
  createdAt               DateTime @default(now())
  updatedAt               DateTime @updatedAt

  user User @relation(fields: [userId], references: [id])

  @@index([userId, updatedAt])
}

model Badge {
  id          String   @id @default(cuid())
  code        String   @unique
  name        String
  description String
  iconName    String
  criteria    Json
  isActive    Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  userBadges UserBadge[]

  @@index([isActive, code])
}

model UserBadge {
  id        String   @id @default(cuid())
  userId    String
  badgeId   String
  chapterId String?
  scopeKey  String   @default("global")
  awardedAt DateTime @default(now())

  user    User     @relation(fields: [userId], references: [id])
  badge   Badge    @relation(fields: [badgeId], references: [id])
  chapter Chapter? @relation(fields: [chapterId], references: [id])

  @@unique([userId, badgeId, scopeKey])
  @@index([userId, awardedAt])
  @@index([badgeId, awardedAt])
  @@index([chapterId, awardedAt])
}

model Subscription {
  id                     String    @id @default(cuid())
  userId                 String
  provider               String
  providerCustomerId     String?
  providerSubscriptionId String?
  planCode               String
  status                 String
  currentPeriodStart     DateTime?
  currentPeriodEnd       DateTime?
  cancelAtPeriodEnd      Boolean   @default(false)
  createdAt              DateTime  @default(now())
  updatedAt              DateTime  @updatedAt

  user User @relation(fields: [userId], references: [id])

  @@index([userId, status])
  @@index([provider, providerCustomerId])
  @@index([provider, providerSubscriptionId])
}

model ProgressEvent {
  id         String   @id @default(cuid())
  userId     String
  eventType  String
  subjectId  String?
  chapterId  String?
  topicId    String?
  lessonId   String?
  quizId     String?
  metadata   Json?
  occurredAt DateTime
  receivedAt DateTime @default(now())

  user User @relation(fields: [userId], references: [id])

  @@index([userId, receivedAt])
  @@index([userId, lessonId, eventType, receivedAt])
  @@index([lessonId, eventType, receivedAt])
}

model StudentFeedback {
  id          String   @id @default(uuid())
  userId      String?
  category    String // "suggestion", "bug", "content_error", "general"
  subject     String? // "mathematics", "science", "social_science", "english", "general"
  chapter     String? // specific chapter if related to content
  title       String   @db.VarChar(200)
  description String   @db.Text
  rating      Int? // 1-5 stars, optional
  status      String   @default("new") // "new", "reviewed", "in_progress", "resolved"
  adminNotes  String?  @db.Text
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([category])
  @@index([status])
  @@index([createdAt])
}

// Sample Test Exam Paper Generator (Maths 041 pilot).
// QuestionBankQuestion is the curated, verifiable question pool. ExamPaper and
// ExamPaperQuestion snapshot every generated paper so it stays reproducible
// and auditable after the bank or blueprint changes. JSON columns keep the
// statement/answer content self-contained; provenance and verification verdicts
// mirror the board-exam-evidence publication rules in docs/.

enum QuestionSourceKind {
  ncert_exercise
  verified_pyq
  board_style
}

enum QuestionVerificationStatus {
  unverified
  review
  verified
  rejected
}

enum ExamPaperVerificationStatus {
  unverified
  review
  verified
  rejected
}

model QuestionBankQuestion {
  id                 String                    @id @default(cuid())
  subjectSlug        String
  bankKey            String
  chapterSlug        String
  unitId             String
  topicId            String
  questionType       String
  marks              Int
  difficulty         String                    @default("medium")
  sourceKind         QuestionSourceKind        @default(board_style)
  provenanceJson     Json?
  variantsJson       Json
  verificationStatus QuestionVerificationStatus @default(unverified)
  reviewNotes        String?
  verifiedAt         DateTime?
  createdAt          DateTime                  @default(now())
  updatedAt          DateTime                  @updatedAt

  papers ExamPaperQuestion[]

  @@unique([subjectSlug, bankKey])
  @@index([subjectSlug, verificationStatus])
  @@index([subjectSlug, unitId, questionType, marks])
  @@index([topicId])
}

model ExamPaper {
  id                 String                     @id @default(cuid())
  userId             String?
  subjectSlug        String
  title              String
  totalMarks         Int
  durationMinutes    Int
  readingTimeMinutes Int
  seed               Int
  layoutVersion      String
  sectionsJson       Json
  verificationStatus ExamPaperVerificationStatus @default(unverified)
  verificationJson   Json?
  publishStatus      String                     @default("draft")
  createdAt          DateTime                   @default(now())
  updatedAt          DateTime                   @updatedAt

  questions ExamPaperQuestion[]
  attempts ExamPaperAttempt[]

  @@index([userId, createdAt])
  @@index([subjectSlug, verificationStatus])
}

model ExamPaperQuestion {
  id                 String   @id @default(cuid())
  examPaperId        String
  questionBankId     String?
  sectionId          String
  questionNumber     Int
  questionType       String
  marks              Int
  statementJson      Json
  answerKeyJson      Json
  sourceKind         String
  provenanceJson     Json?
  verificationStatus String   @default("unverified")
  verificationJson   Json?
  sortOrder          Int

  examPaper    ExamPaper             @relation(fields: [examPaperId], references: [id], onDelete: Cascade)
  questionBank QuestionBankQuestion? @relation(fields: [questionBankId], references: [id])

  @@unique([examPaperId, questionNumber])
  @@index([examPaperId, sectionId])
}

// RAG corpus for the Tara-Firefly AI Tutor.
// RagChunk holds one indexed passage from the platform's NCERT-faithful
// chapter packs / lesson notes. The embedding column uses the pgvector
// extension; the build script (src/scripts/build-rag-index.ts) owns all rows.
model RagChunk {
  id           String                      @id @default(cuid())
  subject      String
  chapterSlug  String
  sectionTitle String
  content      String                      @db.Text
  tokenCount   Int
  sourcePath   String
  sourceRank   Int                         @default(0)
  contentHash  String
  embedding    Unsupported("vector(3072)")?
  createdAt    DateTime                    @default(now())
  updatedAt    DateTime                    @updatedAt

  @@unique([contentHash])
  @@index([subject, chapterSlug])
}

// Tara-Firefly AI Tutor conversations. Per-student persistence: a conversation
// owns a thread of messages; attachments are stored in Bunny Storage and only
// their metadata (path, kind, size) lives here.
model TutorConversation {
  id        String   @id @default(cuid())
  userId    String
  title     String   @default("New conversation")
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user     User           @relation(fields: [userId], references: [id])
  messages TutorMessage[]

  @@index([userId, updatedAt])
}

model TutorMessage {
  id              String   @id @default(cuid())
  conversationId  String
  role            String // "user" | "assistant"
  contentMarkdown String   @db.Text
  citedChunkIds   Json?
  createdAt       DateTime @default(now())

  conversation TutorConversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  attachments  TutorAttachment[]

  @@index([conversationId, createdAt])
}

model TutorAttachment {
  id             String   @id @default(cuid())
  messageId      String
  kind           String // "image" | "pdf"
  storagePath    String
  mimeType       String
  sizeBytes      Int
  fileName       String
  createdAt      DateTime @default(now())

  message TutorMessage @relation(fields: [messageId], references: [id], onDelete: Cascade)

  @@index([messageId])
}

enum PaymentOrderStatus {
  created
  paid
  failed
  refunded
}

enum EntitlementStatus {
  active
  expired
  revoked
}

model PaymentOrder {
  id                String             @id @default(cuid())
  userId            String
  razorpayOrderId   String             @unique
  amount            Int                // In paise (e.g. 19900 = ₹199)
  currency          String             @default("INR")
  productKey        String
  subjectSlug       String?
  status            PaymentOrderStatus @default(created)
  razorpayPaymentId String?
  razorpaySignature String?
  receipt           String
  notesJson         Json?
  createdAt         DateTime           @default(now())
  updatedAt         DateTime           @updatedAt

  user           User              @relation(fields: [userId], references: [id])
  entitlements   UserEntitlement[]
  refundRequests RefundRequest[]

  @@index([userId, status])
  @@index([razorpayOrderId])
}

model UserEntitlement {
  id             String            @id @default(cuid())
  userId         String
  productKey     String
  subjectSlug    String?
  scope          String            @default("mock_test_series")
  status         EntitlementStatus @default(active)
  paymentOrderId String?
  validFrom      DateTime          @default(now())
  validUntil     DateTime?
  createdAt      DateTime          @default(now())
  updatedAt      DateTime          @updatedAt

  user         User          @relation(fields: [userId], references: [id])
  paymentOrder PaymentOrder? @relation(fields: [paymentOrderId], references: [id])

  @@unique([userId, productKey, subjectSlug])
  @@index([userId, status])
  @@index([userId, scope, status])
}

enum RefundRequestStatus {
  pending
  approved
  rejected
  processed
}

enum RefundType {
  total
  partial
  subject_swap
}

model RefundRequest {
  id               String              @id @default(cuid())
  userId           String
  paymentOrderId   String
  reason           String              // "duplicate", "accidental", "technical", "other"
  details          String?
  refundType       RefundType          @default(total)
  amountPaise      Int                 // in paise (e.g. 19900)
  status           RefundRequestStatus @default(pending)
  razorpayRefundId String?
  adminNotes       String?
  processedAt      DateTime?
  createdAt        DateTime            @default(now())
  updatedAt        DateTime            @updatedAt

  user         User         @relation(fields: [userId], references: [id])
  paymentOrder PaymentOrder @relation(fields: [paymentOrderId], references: [id])

  @@index([userId, status])
  @@index([paymentOrderId])
}


