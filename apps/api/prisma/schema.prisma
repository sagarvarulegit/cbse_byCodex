generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

enum UserRole {
  student
  admin
  teacher_reviewer
  support
}

enum AccessLevel {
  free
  premium
}

enum PublishStatus {
  draft
  review
  published
  archived
}

enum MasteryLevel {
  learner
  skilled
  exam_ready
  topper_track
}

enum RevisionMissionStatus {
  active
  completed
  expired
}

model User {
  id           String   @id @default(cuid())
  email        String?  @unique
  phone        String?  @unique
  passwordHash String?
  role         UserRole @default(student)
  status       String   @default("active")
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  profile          UserProfile?
  subscriptions    Subscription[]
  progressEvents   ProgressEvent[]
  quizAttempts     QuizAttempt[]
  chapterMasteries ChapterMastery[]
  revisionMissions RevisionMission[]
}

model UserProfile {
  id                String   @id @default(cuid())
  userId            String   @unique
  fullName          String
  classLevel        Int      @default(10)
  schoolName        String?
  targetExamYear    Int?
  preferredLanguage String   @default("en")
  themePreference   String   @default("system")
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt

  user User @relation(fields: [userId], references: [id])
}

model Subject {
  id          String  @id @default(cuid())
  classLevel  Int
  name        String
  slug        String  @unique
  description String?
  sortOrder   Int     @default(0)
  isPublished Boolean @default(false)

  chapters Chapter[]

  @@index([classLevel, isPublished, sortOrder])
}

model Chapter {
  id                 String  @id @default(cuid())
  subjectId          String
  title              String
  slug               String  @unique
  ncertChapterNumber Int
  description        String?
  sortOrder          Int     @default(0)
  isPublished        Boolean @default(false)

  subject          Subject           @relation(fields: [subjectId], references: [id])
  topics           Topic[]
  quizAttempts     QuizAttempt[]
  chapterMasteries ChapterMastery[]
  revisionMissions RevisionMission[]

  @@unique([subjectId, slug])
  @@index([subjectId, isPublished, sortOrder])
  @@index([slug, isPublished])
}

model Topic {
  id               String  @id @default(cuid())
  chapterId        String
  title            String
  slug             String
  description      String?
  sortOrder        Int     @default(0)
  estimatedMinutes Int?
  isPublished      Boolean @default(false)

  chapter          Chapter           @relation(fields: [chapterId], references: [id])
  lessons          Lesson[]
  quizAttempts     QuizAttempt[]
  revisionMissions RevisionMission[]

  @@unique([chapterId, slug])
  @@index([chapterId, isPublished, sortOrder])
}

model Lesson {
  id                String        @id @default(cuid())
  topicId           String
  title             String
  slug              String
  description       String?
  learningObjective String?
  accessLevel       AccessLevel   @default(premium)
  sortOrder         Int           @default(0)
  estimatedMinutes  Int?
  publishStatus     PublishStatus @default(draft)
  publishedAt       DateTime?
  createdAt         DateTime      @default(now())
  updatedAt         DateTime      @updatedAt

  topic  Topic   @relation(fields: [topicId], references: [id])
  videos Video[]
  notes  Note[]

  @@unique([topicId, slug])
  @@index([topicId, publishStatus, sortOrder])
  @@index([slug, publishStatus])
}

model Video {
  id                String    @id @default(cuid())
  lessonId          String
  provider          String    @default("bunny")
  providerLibraryId String?
  providerVideoId   String?
  playbackUrl       String?
  embedUrl          String?
  durationSeconds   Int?
  thumbnailUrl      String?
  drmRequired       Boolean   @default(false)
  offlineAllowed    Boolean   @default(false)
  processingStatus  String    @default("pending")
  statusSyncedAt    DateTime?
  createdAt         DateTime  @default(now())
  updatedAt         DateTime  @updatedAt

  lesson Lesson @relation(fields: [lessonId], references: [id])

  @@unique([provider, providerVideoId])
  @@index([lessonId, provider, updatedAt])
  @@index([processingStatus, statusSyncedAt])
}

model Note {
  id                     String   @id @default(cuid())
  lessonId               String
  title                  String
  bodyMarkdown           String
  summaryMarkdown        String?
  formulaMarkdown        String?
  commonMistakesMarkdown String?
  boardTipsMarkdown      String?
  createdAt              DateTime @default(now())
  updatedAt              DateTime @updatedAt

  lesson Lesson @relation(fields: [lessonId], references: [id])

  @@index([lessonId, createdAt])
}

model Quiz {
  id                  String      @id @default(cuid())
  title               String
  quizType            String
  accessLevel         AccessLevel @default(premium)
  timeLimitSeconds    Int?
  passingScorePercent Int?
  isPublished         Boolean     @default(false)
  createdAt           DateTime    @default(now())
  updatedAt           DateTime    @updatedAt

  attempts QuizAttempt[]
}

model QuizAttempt {
  id             String   @id @default(cuid())
  userId         String
  chapterId      String
  topicId        String?
  quizId         String?
  scorePercent   Int
  totalQuestions Int
  correctAnswers Int
  weakTopicSlugs String[] @default([])
  attemptNumber  Int
  createdAt      DateTime @default(now())

  user    User    @relation(fields: [userId], references: [id])
  chapter Chapter @relation(fields: [chapterId], references: [id])
  topic   Topic?  @relation(fields: [topicId], references: [id])
  quiz    Quiz?   @relation(fields: [quizId], references: [id])

  @@unique([userId, chapterId, attemptNumber])
  @@index([userId, chapterId, createdAt])
  @@index([chapterId, scorePercent])
  @@index([quizId, createdAt])
}

model ChapterMastery {
  id                     String       @id @default(cuid())
  userId                 String
  chapterId              String
  masteryScore           Int          @default(0)
  level                  MasteryLevel @default(learner)
  videoCompletionPercent Int          @default(0)
  bestQuizScorePercent   Int          @default(0)
  lastActivityAt         DateTime?
  createdAt              DateTime     @default(now())
  updatedAt              DateTime     @updatedAt

  user    User    @relation(fields: [userId], references: [id])
  chapter Chapter @relation(fields: [chapterId], references: [id])

  @@unique([userId, chapterId])
  @@index([userId, level, updatedAt])
  @@index([chapterId, masteryScore])
}

model RevisionMission {
  id               String                @id @default(cuid())
  userId           String
  chapterId        String
  topicId          String?
  status           RevisionMissionStatus @default(active)
  reason           String
  targetScore      Int                   @default(60)
  recommendedSteps Json
  createdAt        DateTime              @default(now())
  completedAt      DateTime?
  updatedAt        DateTime              @updatedAt

  user    User    @relation(fields: [userId], references: [id])
  chapter Chapter @relation(fields: [chapterId], references: [id])
  topic   Topic?  @relation(fields: [topicId], references: [id])

  @@index([userId, status, updatedAt])
  @@index([chapterId, status])
}

model Subscription {
  id                     String    @id @default(cuid())
  userId                 String
  provider               String
  providerCustomerId     String?
  providerSubscriptionId String?
  planCode               String
  status                 String
  currentPeriodStart     DateTime?
  currentPeriodEnd       DateTime?
  cancelAtPeriodEnd      Boolean   @default(false)
  createdAt              DateTime  @default(now())
  updatedAt              DateTime  @updatedAt

  user User @relation(fields: [userId], references: [id])

  @@index([userId, status])
  @@index([provider, providerCustomerId])
  @@index([provider, providerSubscriptionId])
}

model ProgressEvent {
  id         String   @id @default(cuid())
  userId     String
  eventType  String
  subjectId  String?
  chapterId  String?
  topicId    String?
  lessonId   String?
  quizId     String?
  metadata   Json?
  occurredAt DateTime
  receivedAt DateTime @default(now())

  user User @relation(fields: [userId], references: [id])

  @@index([userId, receivedAt])
  @@index([userId, lessonId, eventType, receivedAt])
  @@index([lessonId, eventType, receivedAt])
}
