output/

# Vercel local project metadata
.vercel/
**/.vercel/
.vercel
# Video work is source controlled: script, storyboard, design system, scene
# templates, and PAID generated assets (ElevenLabs mp3s, thumbnails, captions)
# are tracked as our assets. Heavy/regenerable output (renders, node_modules,
# ffmpeg wav conversions, backups) is ignored via each video folder's local
# .gitignore — see the canonical template in AGENTS.md (Video folder git policy).
videos/
!videos/
videos/*
!videos/*/
# Safety net for any video folder that lacks a local .gitignore yet
**/renders/
**/.hyperframes/
**/snapshots*/

.vercel
# Local rendering tools copied from system installations
.codex-tmp/
# Reasonix local session artifacts
.reasonix/

# Large textbook archives/extractions (source of truth lives outside the repo in cbse_KB)
textbooks/
textbooks-*.zip
*.zip

# Temporary scraping, inspection, and extraction dumps
tmp/

# Regenerable uncompressed audio
*.wav

# Repomix dumps
chapterready-codebase.txt

# Video renders (always ignored per video policy)
*.mp4

# HyperFrames generated preview frame snapshots in .thumbnails
**/.thumbnails/v*

# Superpowers temporary diffs and reports
.superpowers/

# Temporary sample paper pdf dumps
ss_*.pdf
