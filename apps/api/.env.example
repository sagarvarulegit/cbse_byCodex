PORT=4000
CORS_ORIGIN="http://localhost:3000,http://localhost:3001"
AUTH_TOKEN_SECRET="replace-with-a-long-random-secret"
AUTH_SESSION_DAYS=14

# Full-access QA accounts (comma-separated emails). These users unlock every
# paid pack without buying anything. Leave empty in production unless testing.
TEST_USER_EMAILS="testuser@chapterready.in"
# Runtime connection for Vercel/serverless. Use Supabase Supavisor transaction pooler.
DATABASE_URL="postgresql://prisma.<project-ref>:<password>@<region>.pooler.supabase.com:6543/postgres?pgbouncer=true&connection_limit=1"

# Migration connection. Use Supabase direct connection or Supavisor session pooler.
DIRECT_URL="postgresql://prisma.<project-ref>:<password>@<region>.pooler.supabase.com:5432/postgres"

ELEVENLABS_API_KEY=""
ELEVENLABS_VOICE_ID="g14YnDYCsy3k7XLlcKlO"

# Bunny Stream. Server-only; do not expose these to the browser.
BUNNY_STREAM_LIBRARY_ID=""
BUNNY_STREAM_API_KEY=""
BUNNY_STREAM_CDN_HOSTNAME="<pull-zone>.b-cdn.net"
BUNNY_STREAM_TOKEN_AUTH_KEY=""
BUNNY_STREAM_SIGNED_URL_TTL_SECONDS=1800
VIDEO_ACTIVE_STATUS_SYNC_TTL_SECONDS=30
VIDEO_TERMINAL_STATUS_SYNC_TTL_SECONDS=21600
BUNNY_STORAGE_ZONE_NAME=""
BUNNY_STORAGE_ACCESS_KEY=""
BUNNY_STORAGE_ENDPOINT="https://storage.bunnycdn.com"

# ── Tara-Firefly AI Tutor ─────────────────────────────────────────────────────
# Gemini chat model for tutor answers (gemini-2.5-flash is the current stable Flash).
GEMINI_MODEL="gemini-2.5-flash"
# Gemini embedding model for the RAG corpus (returns 3072-dim vectors).
GEMINI_EMBEDDING_MODEL="gemini-embedding-001"
# Free-tier daily doubt limit per student.
TUTOR_DAILY_LIMIT=30
# Number of RAG chunks retrieved per question.
TUTOR_RAG_TOP_K=6
# ── Transactional Email (Resend) ─────────────────────────────────────────────
# Resend API key (https://resend.com/api-keys)
RESEND_API_KEY="re_..."
# Verified sender domain (e.g. ChapterReady <support@chapterready.in> or ChapterReady <onboarding@resend.dev>)
EMAIL_FROM="ChapterReady <support@chapterready.in>"

