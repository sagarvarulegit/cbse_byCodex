{
  "description": "Run the repo pre-push knowledge checks before agent-driven git pushes.",
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "functions.shell_command",
        "hooks": [
          {
            "type": "command",
            "command": "powershell.exe -NoProfile -ExecutionPolicy Bypass -Command \"$inputJson = [Console]::In.ReadToEnd(); if ($inputJson -match 'git\\s+push') { if (Test-Path '.githooks/pre-push') { & 'C:\\Program Files\\Git\\usr\\bin\\sh.exe' '.githooks/pre-push' } }\""
          }
        ]
      }
    ]
  }
}
